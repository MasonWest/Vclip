# Copy this file to .env and update the values

# 入口路径（服务端强制校验，不匹配一律返回 404；不会打包进前端）
SECRET_PATH=my-private-space

# 访问密码（Basic Auth / 登录页共用）
# 建议 16 位以上随机串，浏览器登录一次后一年内免密，复杂密码不会带来输入负担
# 生成方式：node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
# 留空则完全关闭鉴权
ACCESS_PASSWORD=replace-with-a-long-random-secret

# 局域网免密：true 时，来自私有网段（10.x / 172.16-31.x / 192.168.x）的请求
# 直接放行，不需要密码也不需要入口路径。适合 VR 头显、手机这类打字困难的设备。
# 代价：同一 WiFi 下的其他设备也能访问。公网来源不受影响，仍需密码。
LAN_FREE_ACCESS=false

# 可选：服务端口，默认 4173
# PORT=4173

# 可选：SQLite 数据库文件路径，默认 data/vclip.db
# DB_PATH=data/vclip.db
