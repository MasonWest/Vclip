# Copy this file to .env and update the values.

# 必填：隐藏入口，仅服务端读取。只允许一段字母、数字、_ 或 -。
# 浏览器必须访问 http://内网IP:4173/这里设置的路径，其他页面一律 404。
SECRET_PATH=my-private-space

# 必填：首次访问必须输入的密码。留空时拒绝启动。
# 浏览器登录后用 HttpOnly Cookie 记住一年；改密码后所有旧会话失效。
# API 联动可使用同一密码的 Basic Auth。
ACCESS_PASSWORD=replace-with-a-long-random-secret

# 可选：服务端口，默认 4173
# PORT=4173

# 可选：SQLite 数据库文件路径，默认 data/vclip.db
# DB_PATH=data/vclip.db
